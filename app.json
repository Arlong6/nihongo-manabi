{
  "expo": {
    "name": "Nihongo Manabi",
    "slug": "nihongo-manabi",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nihongomanabi.app",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "需要麥克風來練習日文發音",
        "NSSpeechRecognitionUsageDescription": "需要語音辨識來評估你的日文發音",
        "NSCameraUsageDescription": "需要相機來拍攝日文招牌、菜單即時翻譯",
        "NSPhotoLibraryUsageDescription": "從相簿挑選含日文的照片來辨識翻譯"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "95049585-302e-4e33-80eb-53d525bf8c82"
      }
    },
    "owner": "arlong0120",
    "plugins": [
      "expo-localization",
      "expo-video",
      "expo-speech-recognition",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" }
        }
      ]
    ]
  }
}
